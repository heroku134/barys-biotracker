rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /users/{userId}
    // Document ID: Firebase Auth UID
    // Fields:
    //   - profileRaw: string (optional, max 20000 chars) - Serialized UserProfile JSON
    //   - name: string (optional, max 100 chars) - User display name
    //   - email: string (optional, max 150 chars) - User email address (PII)
    //   - gender: string (optional, max 30 chars) - 'female', 'male', etc.
    //   - hasCompletedProfile: bool (optional) - Onboarding completion flag
    //   - heightCm: number (optional, 30..300) - Height in cm
    //   - weightKg: number (optional, 10..500) - Weight in kg
    //   - birthYear: number (optional, 1900..2100) - Year of birth
    //   - stepGoal: number (optional, 0..500000) - Daily step goal
    //   - calorieGoal: number (optional, 0..50000) - Daily calorie goal
    //   - sleepGoalHours: number (optional, 0..24) - Sleep target in hours
    //   - isPregnant: bool (optional) - Pregnancy status (sensitive health data)
    //   - updatedAt: timestamp (optional) - Profile modification timestamp
    //   - recovery: number (optional, 0..100) - Recovery score percentage
    //   - hrv: number (optional, 0..500) - Heart Rate Variability (ms)
    //   - rhr: number (optional, 0..250) - Resting Heart Rate (bpm)
    //   - recoveryAt: timestamp (optional) - Telemetry timestamp
    //   - fcmToken: string (optional, max 500 chars) - Cloud Messaging token
    //   - fcmUpdatedAt: timestamp (optional) - Token refresh timestamp
    //   - restingHeartRate: number (optional, 0..250) - Telemetry resting heart rate
    //   - currentStrain: number (optional, 0..50) - Daily strain score
    //   - targetStrainMax: number (optional, 0..50) - Recommended strain maximum
    //   - calibrationDay: number (optional, 0..365) - SAAT-1 calibration day counter
    //   - heartRate: number (optional, 0..300) - Current heart rate
    //
    // Collection: /cycle/{userId}
    // Document ID: Firebase Auth UID of the female user
    // Fields:
    //   - cycleDay: number (optional, 1..100) - Current day in menstrual cycle
    //   - cycleLength: number (optional, 10..100) - Cycle length in days
    //   - phase: string (optional, max 50 chars) - Hormonal phase name
    //   - partnerName: string (optional, max 100 chars) - Shared partner label
    //   - mood: string (optional, max 100 chars) - Logged mood
    //   - flow: string (optional, max 100 chars) - Logged flow
    //   - energyScore: number (optional, 0..100) - Energy level score
    //   - symptoms: list (optional, max 50 items) - Selected symptoms list
    //   - note: string (optional, max 2000 chars) - Private cycle note
    //   - updatedAt: timestamp (optional) - Last sync timestamp
    //
    // Subcollection: /cycle/{userId}/viewers/{viewerUid}
    // Document ID: Firebase Auth UID of authorized viewer
    // Fields:
    //   - partnerUid: string (required, 1..128 chars, matches viewerUid)
    //   - code: string (required, 1..64 chars) - Secret invite code used for link
    //   - partnerName: string (optional, max 100 chars) - Viewer display name
    //   - linkedAt: timestamp (optional) - Link establishment timestamp
    //
    // Subcollection: /days/{userId}/snapshots/{dateKey}
    // Document ID: ISO Date string (YYYY-MM-DD)
    // Fields:
    //   - dateKey: string (required, max 20 chars, matches document ID)
    //   - recovery: number (required, 0..100) - Recovery score
    //   - strain: number (required, 0..30) - Strain score
    //   - sleep: number (required, 0..1440) - Sleep duration
    //   - hrv: number (required, 0..500) - HRV in ms
    //   - rhr: number (required, 0..250) - Resting Heart Rate
    //   - preview: bool (optional) - Preview mode indicator
    //
    // Subcollection: /friends/{userId}/members/{memberId}
    // Document ID: Firebase Auth UID of the member/friend
    // Fields:
    //   - uid: string (optional, must match memberId) - Friend UID
    //   - name: string (optional, max 100 chars) - Friend display name
    //   - code: string (optional, 1..64 chars) - Invite code used to link
    //   - recovery: number (optional, 0..100) - Recovery score for Dunbar league
    //   - hrv: number (optional, 0..500) - Friend HRV
    //   - rhr: number (optional, 0..250) - Friend RHR
    //   - updatedAt: timestamp (optional) - Telemetry update timestamp
    //
    // Collection: /invites/{code}
    // Document ID: Formatted invite code (e.g. KALKAN-XXXX)
    // Fields:
    //   - ownerUid: string (required, 1..128 chars) - Creator UID (immutable)
    //   - type: string (required, 'friend' or 'cycle') - Invite purpose
    //   - name: string (optional, max 100 chars) - Owner display name
    //   - createdAt: timestamp (optional) - Creation timestamp
    //   - expiresAt: timestamp (optional) - Invite expiration timestamp
    //
    // Collection: /partners/{userId}
    // Document ID: Firebase Auth UID of the linked partner
    // Fields:
    //   - partnerUid: string (required, 1..128 chars) - Target user UID
    //   - code: string (required, 1..64 chars) - Secret invite code used for link
    //
    // ===============================================================

    // ===============================================================
    // Core Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
        (data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen);
    }

    function isValidOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) ||
        (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    function isValidOptionalBool(data, field) {
      return !(field in data) || (data[field] is bool);
    }

    function isValidOptionalTimestamp(data, field) {
      return !(field in data) || (data[field] is timestamp);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // --- 1. User Profile Validator ---
    function isValidUser(data) {
      return data.keys().hasOnly([
        'profileRaw', 'name', 'email', 'gender', 'hasCompletedProfile',
        'heightCm', 'weightKg', 'birthYear', 'stepGoal', 'calorieGoal',
        'sleepGoalHours', 'isPregnant', 'updatedAt', 'recovery', 'hrv',
        'rhr', 'recoveryAt', 'fcmToken', 'fcmUpdatedAt', 'restingHeartRate',
        'currentStrain', 'targetStrainMax', 'calibrationDay', 'heartRate'
      ]) &&
      isValidOptionalString(data, 'profileRaw', 0, 20000) &&
      isValidOptionalString(data, 'name', 0, 100) &&
      isValidOptionalString(data, 'email', 0, 150) &&
      isValidOptionalString(data, 'gender', 0, 30) &&
      isValidOptionalBool(data, 'hasCompletedProfile') &&
      isValidOptionalNumber(data, 'heightCm', 30, 300) &&
      isValidOptionalNumber(data, 'weightKg', 10, 500) &&
      isValidOptionalNumber(data, 'birthYear', 1900, 2100) &&
      isValidOptionalNumber(data, 'stepGoal', 0, 500000) &&
      isValidOptionalNumber(data, 'calorieGoal', 0, 50000) &&
      isValidOptionalNumber(data, 'sleepGoalHours', 0, 24) &&
      isValidOptionalBool(data, 'isPregnant') &&
      isValidOptionalTimestamp(data, 'updatedAt') &&
      isValidOptionalNumber(data, 'recovery', 0, 100) &&
      isValidOptionalNumber(data, 'hrv', 0, 500) &&
      isValidOptionalNumber(data, 'rhr', 0, 250) &&
      isValidOptionalTimestamp(data, 'recoveryAt') &&
      isValidOptionalString(data, 'fcmToken', 0, 500) &&
      isValidOptionalTimestamp(data, 'fcmUpdatedAt') &&
      isValidOptionalNumber(data, 'restingHeartRate', 0, 250) &&
      isValidOptionalNumber(data, 'currentStrain', 0, 50) &&
      isValidOptionalNumber(data, 'targetStrainMax', 0, 50) &&
      isValidOptionalNumber(data, 'calibrationDay', 0, 365) &&
      isValidOptionalNumber(data, 'heartRate', 0, 300);
    }

    // --- 2. Cycle Data Validator ---
    function isValidCycleData(data) {
      return data.keys().hasOnly([
        'cycleDay', 'cycleLength', 'phase', 'partnerName',
        'mood', 'flow', 'energyScore', 'symptoms', 'note', 'updatedAt'
      ]) &&
      isValidOptionalNumber(data, 'cycleDay', 1, 100) &&
      isValidOptionalNumber(data, 'cycleLength', 10, 100) &&
      isValidOptionalString(data, 'phase', 0, 50) &&
      isValidOptionalString(data, 'partnerName', 0, 100) &&
      isValidOptionalString(data, 'mood', 0, 100) &&
      isValidOptionalString(data, 'flow', 0, 100) &&
      isValidOptionalNumber(data, 'energyScore', 0, 100) &&
      (!( 'symptoms' in data ) || (data.symptoms is list && data.symptoms.size() <= 50)) &&
      isValidOptionalString(data, 'note', 0, 2000) &&
      isValidOptionalTimestamp(data, 'updatedAt');
    }

    // --- 3. Day Snapshot Validator ---
    function isValidDaySnapshot(data, dateKey) {
      return data.keys().hasOnly(['dateKey', 'recovery', 'strain', 'sleep', 'hrv', 'rhr', 'preview']) &&
        data.keys().hasAll(['dateKey', 'recovery', 'strain', 'sleep', 'hrv', 'rhr']) &&
        data.dateKey is string &&
        data.dateKey == dateKey &&
        data.dateKey.size() <= 20 &&
        data.recovery is number && data.recovery >= 0 && data.recovery <= 100 &&
        data.strain is number && data.strain >= 0 && data.strain <= 30 &&
        data.sleep is number && data.sleep >= 0 && data.sleep <= 1440 &&
        data.hrv is number && data.hrv >= 0 && data.hrv <= 500 &&
        data.rhr is number && data.rhr >= 0 && data.rhr <= 250 &&
        isValidOptionalBool(data, 'preview');
    }

    // --- 4. Friend Circle Member Validator ---
    function isValidFriendMember(data, memberId) {
      return data.keys().hasOnly(['uid', 'name', 'code', 'recovery', 'hrv', 'rhr', 'updatedAt']) &&
        (!( 'uid' in data ) || (data.uid is string && data.uid == memberId)) &&
        isValidOptionalString(data, 'name', 0, 100) &&
        isValidOptionalString(data, 'code', 1, 64) &&
        isValidOptionalNumber(data, 'recovery', 0, 100) &&
        isValidOptionalNumber(data, 'hrv', 0, 500) &&
        isValidOptionalNumber(data, 'rhr', 0, 250) &&
        isValidOptionalTimestamp(data, 'updatedAt');
    }

    // --- 5. Invite Code Validator ---
    function isValidInvite(data) {
      return data.keys().hasOnly(['ownerUid', 'type', 'name', 'createdAt', 'expiresAt']) &&
        data.keys().hasAll(['ownerUid', 'type', 'expiresAt']) &&
        data.ownerUid is string &&
        data.ownerUid.size() > 0 &&
        data.ownerUid.size() <= 128 &&
        (data.type == 'friend' || data.type == 'cycle') &&
        isValidOptionalString(data, 'name', 0, 100) &&
        isValidOptionalTimestamp(data, 'createdAt') &&
        data.expiresAt is timestamp;
    }

    // --- 6. Partner Record Validator ---
    function isValidPartnerRecord(data) {
      return data.keys().hasOnly(['partnerUid', 'code', 'linkedAt']) &&
        data.keys().hasAll(['partnerUid', 'code']) &&
        data.partnerUid is string &&
        data.partnerUid.size() > 0 &&
        data.partnerUid.size() <= 128 &&
        data.code is string &&
        data.code.size() > 0 &&
        data.code.size() <= 64 &&
        isValidOptionalTimestamp(data, 'linkedAt');
    }

    // --- 7. Cycle Viewer Record Validator ---
    function isValidCycleViewerRecord(data, userId) {
      return data.keys().hasOnly(['partnerUid', 'partnerName', 'linkedAt', 'code']) &&
        data.keys().hasAll(['partnerUid', 'code']) &&
        data.partnerUid == request.auth.uid &&
        data.code is string &&
        data.code.size() > 0 &&
        data.code.size() <= 64 &&
        isValidOptionalString(data, 'partnerName', 0, 100) &&
        isValidOptionalTimestamp(data, 'linkedAt') &&
        exists(/databases/$(database)/documents/invites/$(data.code)) &&
        isCycleInviteActive(userId, get(/databases/$(database)/documents/invites/$(data.code)).data);
    }

    // --- Partner Cycle Authorization Chain ---
    // Strictly verifies that the reader has a partner record pointing to userId,
    // AND that the partner record contains a code pointing to a valid invite
    // created by userId with type == 'cycle'.
    function isAuthorizedCyclePartner(userId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/partners/$(request.auth.uid)) &&
        isCyclePartnerRecordValid(userId, get(/databases/$(database)/documents/partners/$(request.auth.uid)).data);
    }

    function isCyclePartnerRecordValid(userId, partnerData) {
      return ('partnerUid' in partnerData) &&
        partnerData.partnerUid == userId &&
        ('code' in partnerData) &&
        partnerData.code is string &&
        partnerData.code.size() > 0 &&
        exists(/databases/$(database)/documents/invites/$(partnerData.code)) &&
        isCycleInviteActive(userId, get(/databases/$(database)/documents/invites/$(partnerData.code)).data);
    }

    function isCycleInviteActive(userId, inviteData) {
      return ('type' in inviteData) &&
        inviteData.type == 'cycle' &&
        ('ownerUid' in inviteData) &&
        inviteData.ownerUid == userId &&
        (!('expiresAt' in inviteData) || inviteData.expiresAt > request.time);
    }

    function isCycleInviteValid(userId, inviteData) {
      return isCycleInviteActive(userId, inviteData);
    }

    // --- Friend Member Authorization Chain ---
    // Strictly verifies that the member record includes an invite code,
    // that the invite code exists, belongs to the circle owner (userId),
    // and has type == 'friend'.
    function isAuthorizedFriendInvite(userId, memberData) {
      return ('code' in memberData) &&
        memberData.code is string &&
        memberData.code.size() > 0 &&
        memberData.code.size() <= 64 &&
        exists(/databases/$(database)/documents/invites/$(memberData.code)) &&
        isFriendInviteValid(userId, get(/databases/$(database)/documents/invites/$(memberData.code)).data);
    }

    function isFriendInviteValid(userId, inviteData) {
      return ('type' in inviteData) &&
        inviteData.type == 'friend' &&
        ('ownerUid' in inviteData) &&
        inviteData.ownerUid == userId &&
        ('expiresAt' in inviteData) &&
        inviteData.expiresAt is timestamp &&
        inviteData.expiresAt > request.time;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. User Profile & Biometrics (PII Protected)
    match /users/{userId} {
      // Strictly owner-only read. Solves privacy vulnerability where any
      // authenticated user could dump raw profile, pregnancy status, biometric metrics.
      allow read: if isOwner(userId);

      // Writes are strictly restricted to the owner with domain schema validation.
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // 2. Reproductive Health Cycle Data
    match /cycle/{userId} {
      // Owner can write/update their cycle data with domain validation.
      allow create: if isOwner(userId) && isValidCycleData(request.resource.data);
      allow update: if isOwner(userId) && isValidCycleData(request.resource.data);
      allow delete: if isOwner(userId);

      // Reader must be the owner OR an authorized viewer listed in cycle's viewers subcollection
      // OR an authorized partner who possesses a valid invite created by the cycle owner.
      allow read: if isOwner(userId) ||
        (isAuthenticated() && exists(/databases/$(database)/documents/cycle/$(userId)/viewers/$(request.auth.uid))) ||
        isAuthorizedCyclePartner(userId);

      // Dedicated viewers subcollection for cycle data access
      match /viewers/{viewerUid} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == viewerUid);
        allow create: if isAuthenticated() && request.auth.uid == viewerUid && isValidCycleViewerRecord(request.resource.data, userId);
        allow update: if false;
        allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.uid == viewerUid);
      }
    }

    // 3. Daily Biometric Snapshots
    match /days/{userId}/snapshots/{dateKey} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidDaySnapshot(request.resource.data, dateKey);
      allow update: if isOwner(userId) &&
        request.resource.data.dateKey == resource.data.dateKey &&
        isValidDaySnapshot(request.resource.data, dateKey);
      allow delete: if isOwner(userId);
    }

    // 4. Dunbar Friends Circle
    match /friends/{userId}/members/{memberId} {
      // Owner can read their circle
      allow read: if isOwner(userId);

      // Allowed if owner managing their circle OR friend accepting invite with verified code
      allow create: if (isOwner(userId) && isValidFriendMember(request.resource.data, memberId)) ||
        (isAuthenticated() && request.auth.uid == memberId &&
         isValidFriendMember(request.resource.data, memberId) &&
         isAuthorizedFriendInvite(userId, request.resource.data));

      // Allowed if owner updating member OR friend updating their own metrics
      allow update: if (isOwner(userId) && isValidFriendMember(request.resource.data, memberId)) ||
        (isAuthenticated() && request.auth.uid == memberId &&
         isValidFriendMember(request.resource.data, memberId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recovery', 'hrv', 'rhr', 'name', 'updatedAt']));

      // Allowed if owner removing a member OR friend leaving the circle
      allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.uid == memberId);
    }

    // 5. Single-use and Multi-use Invite Codes
    match /invites/{code} {
      // Strictly prevent listing/enumeration attacks
      allow list: if false;

      // Allow get by exact code only until expiration (blocks enumeration & expired reuse)
      allow get: if isAuthenticated() &&
        'expiresAt' in resource.data &&
        resource.data.expiresAt is timestamp &&
        resource.data.expiresAt > request.time;

      // Only creator can create invites with their own UID
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        isValidInvite(request.resource.data);

      // Only owner can update invite; ownerUid is immutable
      allow update: if isAuthenticated() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        isValidInvite(request.resource.data);

      // Only owner can delete invite
      allow delete: if isAuthenticated() &&
        resource.data.ownerUid == request.auth.uid;
    }

    // 6. Partner Link Records
    match /partners/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidPartnerRecord(request.resource.data);
      allow update: if isOwner(userId) && isValidPartnerRecord(request.resource.data);
    }
  }
}
