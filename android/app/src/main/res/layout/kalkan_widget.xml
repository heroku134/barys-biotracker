        <LinearLayout android:orientation="vertical" android:layout_marginEnd="14dp">
            <TextView android:text="Восст." android:textColor="#8A909D" android:textSize="10sp" />
            <TextView android:id="@+id/widget_recovery" android:text="—" android:textColor="#EDEDED" android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical">
            <TextView android:text="Нагр." android:textColor="#8A909D" android:textSize="10sp" />
            <TextView android:id="@+id/widget_strain" android:text="—" android:textColor="#EDEDED" android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_line"
        android:text=""
        android:textColor="#8A909D"
        android:textSize="11sp"
        android:paddingTop="6dp"
        android:maxLines="2" />
</LinearLayout>
