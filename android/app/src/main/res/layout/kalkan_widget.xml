    <LinearLayout android:orientation="horizontal" android:paddingTop="6dp">
        <LinearLayout android:orientation="vertical" android:layout_marginEnd="14dp">
            <TextView android:text="Сон" android:textColor="#8A909D" android:textSize="10sp" />
            <TextView android:id="@+id/widget_sleep" android:text="—" android:textColor="#EDEDED" android:textSize="20sp" />
