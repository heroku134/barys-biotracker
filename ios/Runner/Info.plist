<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>KALKAN SPORT</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>barys_biotracker</string>

	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Приложению требуется Bluetooth для подключения к часам KALKAN СААТ-1 и синхронизации биометрии.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Приложению требуется доступ к Bluetooth для поиска смарт-часов.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Приложению требуется доступ к галерее для выбора фото профиля и публикации фото дня.</string>
	<key>NSCameraUsageDescription</key>
	<string>Приложению требуется камера для создания снимков тренировок и фото дня.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Приложению требуется микрофон для записи звука во время видео-тренировок.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Приложению требуется доступ к геолокации для записи маршрута, темпа и дистанции беговой тренировки.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Приложению требуется доступ к геолокации в фоновом режиме для точной записи бегового трека.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>КАЛКАН считывает пульс, вариабельность (HRV), сон, шаги и тренировки для расчёта показателей готовности и восстановления.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>КАЛКАН синхронизирует записанные тренировки, показатели восстановления и сна с Apple Health.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>sport.kalkan.bio.refresh</string>
	</array>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
